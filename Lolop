end

--==================================================
-- ACTIVAR / DESACTIVAR
--==================================================

AimbotButton.MouseButton1Click:Connect(function()

    Aimbot = not Aimbot

    if Aimbot then

        AimbotButton.Text = "AIMBOT : ON"
        AimbotButton.BackgroundColor3 =
            Color3.fromRGB(45,90,55)

        CreateAimVisuals()

        --==================================================
        -- AIMBOT + TELETRANSPORTE CADA 0.5s
        --==================================================

        task.spawn(function()

            while Aimbot do

                local Character = LP.Character

                local Root =
                    Character and
                    Character:FindFirstChild("HumanoidRootPart")

                local Humanoid =
                    Character and
                    Character:FindFirstChildOfClass("Humanoid")

                Target = GetClosestPlayer()

                -- SPEED 190
                if Humanoid then
                    Humanoid.WalkSpeed = AimbotSpeed
                end

                -- INF HEALTH
                if Humanoid then
                    Humanoid.Health = Humanoid.MaxHealth
                end

                -- TELETRANSPORTE
                if Root and Target and Target.Character then

                    local TargetRoot =
                        Target.Character:FindFirstChild(
                            "HumanoidRootPart"
                        )

                    if TargetRoot then

                        Root.CFrame =
                            TargetRoot.CFrame *
                            CFrame.new(0,0,2)

                    end
                end

                task.wait(0.5)

            end

        end)

    else

        AimbotButton.Text = "AIMBOT : OFF"
        AimbotButton.BackgroundColor3 =
            Color3.fromRGB(35,35,43)

        Target = nil

        RemoveAimVisuals()

        -- VOLVER A VELOCIDAD NORMAL
        local Character = LP.Character

        local Humanoid =
            Character and
            Character:FindFirstChildOfClass("Humanoid")

        if Humanoid then
            Humanoid.WalkSpeed = NormalSpeed
        end

    end

end)

--==================================================
-- ACTUALIZACIÓN VISUAL
--==================================================

RunService.RenderStepped:Connect(function()

    if not Aimbot then
        return
    end

    local Character = LP.Character

    if not Character then
        return
    end

    local Root =
        Character:FindFirstChild("HumanoidRootPart")

    local Humanoid =
        Character:FindFirstChildOfClass("Humanoid")

    if Humanoid then

        Humanoid.WalkSpeed = AimbotSpeed

        -- Mantener vida al máximo
        Humanoid.Health = Humanoid.MaxHealth

    end

    Target = GetClosestPlayer()

    if Target and Target.Character then

        local Head =
            Target.Character:FindFirstChild("Head")

        if Head then

            -- APUNTAR A LA CABEZA
            Camera.CFrame = CFrame.lookAt(
                Camera.CFrame.Position,
                Head.Position
            )

            -- CUADRO BLANCO
            if AimBox then
                AimBox.Adornee = Target.Character
            end

            -- LÍNEA BLANCA
            if AimLine and Root then

                LineA0 =
                    Root:FindFirstChild(
                        "HOLD_JUP_LINE_START"
                    )

                if not LineA0 then

                    LineA0 = Instance.new("Attachment")
                    LineA0.Name =
                        "HOLD_JUP_LINE_START"
                    LineA0.Parent = Root

                end

                LineA1 =
                    Head:FindFirstChild(
                        "HOLD_JUP_LINE_END"
                    )

                if not LineA1 then

                    LineA1 = Instance.new("Attachment")
                    LineA1.Name =
                        "HOLD_JUP_LINE_END"
                    LineA1.Parent = Head

                end

                AimLine.Attachment0 = LineA0
                AimLine.Attachment1 = LineA1

            end

        end

    else

        if AimBox then
            AimBox.Adornee = nil
        end

    end

end)

--==================================================
-- ARRASTRAR MENÚ
--==================================================

local Dragging = false
local DragStart
local StartPosition

Header.InputBegan:Connect(function(Input)

    if Input.UserInputType == Enum.UserInputType.MouseButton1
    or Input.UserInputType == Enum.UserInputType.Touch then

        Dragging = true
        DragStart = Input.Position
        StartPosition = Main.Position

    end

end)

UIS.InputChanged:Connect(function(Input)

    if not Dragging then
        return
    end

    if Input.UserInputType == Enum.UserInputType.MouseMovement
    or Input.UserInputType == Enum.UserInputType.Touch then

        local Delta =
            Input.Position - DragStart

        Main.Position = UDim2.new(
            StartPosition.X.Scale,
            StartPosition.X.Offset + Delta.X,
            StartPosition.Y.Scale,
            StartPosition.Y.Offset + Delta.Y
        )

    end

end)

UIS.InputEnded:Connect(function(Input)

    if Input.UserInputType == Enum.UserInputType.MouseButton1
    or Input.UserInputType == Enum.UserInputType.Touch then

        Dragging = false

    end

end)

